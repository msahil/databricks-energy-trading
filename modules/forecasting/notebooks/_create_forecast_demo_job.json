        "notebook_path": "/Workspace/Users/mohammad.sahil@databricks.com/energy-trading-forecasting-demo/notebooks/01_market_data_and_visualisation",
        "source": "WORKSPACE"
      }
    },
    {
      "task_key": "nb02",
      "depends_on": [{ "task_key": "nb01" }],
      "job_cluster_key": "uc_single_user",
