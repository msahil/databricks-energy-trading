{
  "name": "energy-trading-forecasting-demo",
  "job_clusters": [
    {
      "job_cluster_key": "uc_single_user",
      "new_cluster": {
        "spark_version": "17.3.x-scala2.13",
        "node_type_id": "i3.xlarge",
        "driver_node_type_id": "i3.xlarge",
        "num_workers": 1,
        "data_security_mode": "SINGLE_USER",
        "aws_attributes": {
          "availability": "ON_DEMAND",
          "first_on_demand": 0,
          "spot_bid_price_percent": 100,
          "zone_id": "auto"
        },
        "spark_env_vars": {
          "DEMO_DATA_PATH": "/dbfs/FileStore/energy-trading-forecasting-demo/demo_data"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "nb01",
      "job_cluster_key": "uc_single_user",
